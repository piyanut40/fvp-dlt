<script type="text/javascript">

    function hideAdmin() {
        $(function () {
            $('#adminhide').hide();
            $('#adminhide2').hide();
            $('#adminhide3').hide();
            
        });

    }

    function hideUser() {
        $(function () {
            $('#menu2_3').hide();
            $('#menu7_2').hide();
            $('#Userhide3').hide();
            $('#divT').hide();
        });

    }

    function mySetFunc2(_div) {
        console.log(_div);
        var x = document.getElementById(_div);
        if (x.className.indexOf("w3-show") == -1) {
            x.className += " w3-show";
        } else {
            x.className = x.className.replace(" w3-show", "");
        }

        //        setclass(_div);
    }

</script>



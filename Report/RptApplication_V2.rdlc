  <Code>Function NumEng2Thai(strEng As String) As String
    Dim strThai As String
    Dim strTemp As Byte
    Dim i As Byte
    'strEng = "258963147"
    For i = 1 To Len(strEng)
        strTemp = Asc(Mid$(strEng, i, 1)) + 192
        strThai = strThai &amp; Chr(strTemp)
    Next
    NumEng2Thai =  strThai
End Function</Code>

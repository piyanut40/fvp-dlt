}

.logo{

    width: 40px;
    padding-right: 10px;
}
.textfooter{
  -webkit-column-count: 2; /* Chrome, Safari, Opera */
  -moz-column-count: 2; /* Firefox */
  column-count: 2;
  -webkit-column-gap: 60px; /* Chrome, Safari, Opera */
  -moz-column-gap: 60px; /* Firefox */
  column-gap: 60px;
  padding-top: 1px;
}
.ftbanner {
        background-image: url('image/footer.jpg');
        width:100%;
          background-position: center;
  background-repeat: no-repeat;
  background-size: cover;
}/* Slideshow container */
    .slideshow-container {
        max-width: 100%;
        position: relative;
        margin: auto;
        background-size: cover;
    }

    /* Next & previous buttons    
    .prev, .next {
        cursor: pointer;
        position: absolute;
        top: 50%;
        width: auto;
        padding:64;
        margin-top: -22px;
        color: #000000;
        font-weight: bold;
        font-size: 18px;
        transition: 0.6s ease;
        border-radius: 0 3px 3px 0;
        user-select: none;
    }*/
 
    /* Position the "next button" to the right */
.next {
        right: 0;
        border-radius: 3px 0 0 3px;
}

        /* On hover, add a grey background color */
        .prev:hover, .next:hover {
            background-color: #000000;
            color: #000000;
}
.trapezium 
{
  height:150px;
  width:100%;
  margin:auto;
  overflow:hidden;
  background: 
    linear-gradient(47deg, #542A6B 0%, transparent  0%) left no-repeat,
    linear-gradient(47deg, transparent 50%, #542A6B -50%) right no-repeat;
  background-size: 75% ,100% auto,  139% auto;
	
}

</style>


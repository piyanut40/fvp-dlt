<style type="text/css">
    /*สำหรับ Loading*/
.overlays
{
position: fixed;
z-index: 999;
height: 100%;
width: 100%;
top: 0;
background-color: Black;
filter: alpha(opacity=60);
opacity: 0.6;
-moz-opacity: 0.8;
color:White;

/*เพิ่มมาเองมันมีช่องว่างด้านซ้าย*/
left: 0;
}

.loader {
    border: 16px solid #f3f3f3; /* Light grey */
    border-top: 16px solid #b213be; /* purple */
    border-radius: 50%;
    width: 90px;
    height: 90px;
    animation: spin 2s linear infinite;
    margin-top:200px;
}

@keyframes spin {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
}

</style>   

<style>
.conference_new {
  overflow-y: auto;
  overflow-x: hidden;
  right: 0;
  height: 120px;
  max-width: 700px;
}

.bgbanner
{
  width:100%;
  margin:auto;
  overflow:hidden;
  /*background: 

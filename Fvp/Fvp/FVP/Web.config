    <add key="FileJodit" value="~/Upload/Jodit/"/>
    <add key="FileExcel" value="~/Upload/FileExcel/" />
    <add key="FileQRCode" value="~/Upload/QRCode/"/>
    <add key="FileApt" value="~/Upload/FileApt/"/>
    <add key="FileTravel" value="~/Upload/FileTravel/"/>
    <add key="FileGuide" value="~/Upload/FileGuide/"/>
    <add key="FilePDF" value="~/Upload/FilePDF/"/>
    <add key="FileAttach" value="~/Upload/FileAttach/"/>
    <add key="FileBackupDB" value="~/BackupDB/"/>

  
    <add key="SmtpServer" value="outgoing.mail.go.th"/>

<configuration>
  <connectionStrings>
    
    <add name="BorderTransport" connectionString="" providerName="Npgsql" />
    <add name="TDSCRouting" connectionString="" providerName="Npgsql" />
    <add name="ApplicationServices" connectionString="" providerName="System.Data.SqlClient"/>
  </connectionStrings>

  <appSettings>

    <add key="FilePhotoUser" value="~/Upload/PhotoUser/"/>
    <add key="FileNews" value="~/Upload/News/"/>
    <add key="FileDocNews" value="~/Upload/DocNews/"/>
    <add key="FilePhotoDriver" value="~/Upload/Driver/"/>
    <add key="FileVehicle" value="~/Upload/Vehicle/"/>
    <add key="FileLicenseDriver" value="~/Upload/LicenseDriver/"/>
    <add key="FilePassport" value="~/Upload/Passport/"/>
